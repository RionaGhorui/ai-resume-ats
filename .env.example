# Copy to .env and fill in. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Groq retired llama-3.3-70b-versatile on 2026-08-16. Check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# How LangChain asks for structured output: json_schema | function_calling | json_mode
GROQ_STRUCTURED_METHOD=json_schema

# Where the Streamlit UI finds the API (only change if the API runs elsewhere)
BACKEND_URL=http://127.0.0.1:8000

# --- RAG (Phase 3) ---
# huggingface-free ONNX embeddings via fastembed. Use "fake" only for tests / offline demos.
EMBEDDINGS_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# A skill counts as "demonstrated" by meaning when similarity >= this (0-1). Raise it to be stricter.
SEMANTIC_THRESHOLD=0.55
