# Copy to .env and fill in. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Groq retired llama-3.3-70b-versatile on 2026-08-16. Check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Where the Streamlit UI finds the API (only change if the API runs elsewhere)
BACKEND_URL=http://127.0.0.1:8000
